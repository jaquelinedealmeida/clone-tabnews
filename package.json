{
  "name": "clone-tabnews",
  "version": "1.0.0",
  "description": "Clone do projeto Tab news do Deschamps para o curso.dev",
  "main": "index.js",
  "scripts": {
    "dev": "npm run services:up && next dev --hostname 0.0.0.0 --port 3000",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:down": "docker compose -f infra/compose.yaml down",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "lint:check": "prettier --check .",
    "lint:fix": " prettier --write .",
    "test": "jest",
    "test:watch": "jest --watchAll"
  },
  "author": "Jaqueline de Almeida",
  "license": "MIT",
  "dependencies": {
    "next": "^16.2.3",
    "pg": "^8.11.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "jest": "^29.6.2",
    "jest-environment-node": "^30.4.1",
    "prettier": "^3.8.1"
  }
}
